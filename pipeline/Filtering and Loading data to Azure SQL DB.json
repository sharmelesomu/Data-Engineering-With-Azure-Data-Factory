{
	"name": "Filtering and Loading data to Azure SQL DB",
	"properties": {
		"activities": [
			{
				"name": "Get Metadata From Source",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "Source_to_DB",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "ParquetReadSettings"
					}
				}
			},
			{
				"name": "Filter Parquet",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get Metadata From Source",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata From Source').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@contains(item().name,'.parquet')",
						"type": "Expression"
					}
				}
			}
		],
		"annotations": []
	}
}